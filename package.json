{
  "name": "pal-event-director",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "description": "Build and test tooling for the Pal Event Director UE4SS Lua server mod",
  "scripts": {
    "test": "fengari tests/run.lua",
    "validate": "node tools/validate.mjs",
    "build": "node tools/build.mjs",
    "build:imouto": "node tools/build-imouto-bundle.mjs",
    "build:world-seed": "node tools/build-imouto-world-seed.mjs",
    "check": "npm run test && npm run validate"
  },
  "devDependencies": {
    "archiver": "8.0.0",
    "fengari-node-cli": "0.1.0",
    "yauzl": "3.4.0"
  }
}
